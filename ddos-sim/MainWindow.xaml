<Window x:Class="NTPXSim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NTPX//RUST  ·  Distributed Stress Console v4.0.0  [SIM BUILD]"
        Height="820" Width="1480"
        MinHeight="700" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        Background="#05070A"
        Foreground="#C9D6E3"
        FontFamily="Consolas"
        ResizeMode="CanResize"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <SolidColorBrush x:Key="BG"     Color="#05070A"/>
        <SolidColorBrush x:Key="Panel"  Color="#0B0F16"/>
        <SolidColorBrush x:Key="Panel2" Color="#0E141D"/>
        <SolidColorBrush x:Key="Edge"   Color="#1B2330"/>
        <SolidColorBrush x:Key="Dim"    Color="#5B6B7E"/>
        <SolidColorBrush x:Key="Txt"    Color="#C9D6E3"/>
        <SolidColorBrush x:Key="Green"  Color="#22FF88"/>
        <SolidColorBrush x:Key="Cyan"   Color="#22D3EE"/>
        <SolidColorBrush x:Key="Red"    Color="#FF2D55"/>
        <SolidColorBrush x:Key="Amber"  Color="#FFB020"/>
        <SolidColorBrush x:Key="Purple" Color="#A779FF"/>

        <!-- ══ card shell ══ -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="Hdr" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Txt}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <!-- ══ buttons: flat, bordered, terminal-ish ══ -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
            <Setter Property="Background" Value="#0A1018"/>
            <Setter Property="Foreground" Value="{StaticResource Txt}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#131C28"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#06090E"/>
                                <Setter TargetName="bd" Property="Padding" Value="17,9,15,7"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Txt}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ text fields ══ -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Background" Value="#070A0F"/>
            <Setter Property="Foreground" Value="{StaticResource Green}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="CaretBrush" Value="{StaticResource Green}"/>
            <Setter Property="SelectionBrush" Value="#1E4F3A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Green}"/>
                                <Setter TargetName="bd" Property="Background" Value="#060B09"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2A3A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ slim scrollbars (default WPF chrome reads as "Windows 7" on a dark HUD) ══ -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="#26333F" CornerRadius="2" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ══ progress bar ══ -->
        <Style TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource Green}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid x:Name="PART_Track" Background="#070B10" ClipToBounds="True">
                            <Border BorderBrush="#16202C" BorderThickness="1" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2"
                                    Margin="1"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ splash pulse ══ -->
        <Storyboard x:Key="SimPulse">
            <DoubleAnimation Storyboard.TargetName="SimDot" Storyboard.TargetProperty="Opacity" From="1" To="0.22"
                             Duration="0:0:1.3" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource SimPulse}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border Background="#05070A" Padding="10" BorderBrush="#101821" BorderThickness="1">
        <Grid>
            <!-- ═══════════════════════ MAIN CONSOLE ═══════════════════════ -->
            <Grid x:Name="MainLayer">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===================== HEADER ===================== -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="■" Foreground="{StaticResource Red}" FontSize="22" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform><RotateTransform x:Name="LogoSpin" Angle="0"/></TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Text="NTPX//RUST" Foreground="{StaticResource Green}" FontSize="18" FontWeight="Black" VerticalAlignment="Center"/>
                            <TextBlock Text="  ::  distributed stress console" Foreground="{StaticResource Dim}" FontSize="10.5" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Green}" VerticalAlignment="Center"/>
                                    <TextBlock Text="  WIREGUARD :: AUTHED" Foreground="{StaticResource Green}" FontSize="10.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,0,8,0">
                                <TextBlock Foreground="{StaticResource Cyan}" FontSize="10.5">
                                    <Run Text="KALI :: "/><Run x:Name="KaliIp" Text="10.66.0.2"/>
                                </TextBlock>
                            </Border>
                            <Border BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="3" Padding="6,3">
                                <TextBlock Foreground="{StaticResource Amber}" FontSize="10.5">
                                    <Run Text="OP :: "/><Run Text="ghost_0x7f"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="SIM BUILD · NOTHING LEAVES THIS MACHINE"
                                           Foreground="#3F4C5C" FontSize="8.5" HorizontalAlignment="Right"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Foreground="{StaticResource Dim}" FontSize="9" Text="TX "/>
                                    <TextBlock x:Name="TxCount" Foreground="{StaticResource Dim}" FontSize="9" Text="0 B"/>
                                    <TextBlock Foreground="#33404F" FontSize="9" Text="  ·  SOCKETS "/>
                                    <TextBlock x:Name="SockCount" Foreground="{StaticResource Dim}" FontSize="9" Text="0"/>
                                    <TextBlock Foreground="#33404F" FontSize="9" Text="  ·  PROC "/>
                                    <TextBlock x:Name="ProcCount" Foreground="{StaticResource Dim}" FontSize="9" Text="0"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Foreground="{StaticResource Dim}" FontSize="10" Text="UPTIME " VerticalAlignment="Center"/>
                            <TextBlock x:Name="Uptime" Foreground="{StaticResource Txt}" FontSize="10" Text="00:00:00" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border BorderBrush="#5A2A38" BorderThickness="1" CornerRadius="3" Padding="6,3" Background="#160A10">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="SimDot" Width="6" Height="6" Fill="{StaticResource Red}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="SIM" Foreground="{StaticResource Red}" FontSize="10" FontWeight="Black" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================== BODY ==================== -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="326"/>
                    </Grid.ColumnDefinitions>

                    <!-- ==================== LEFT : CONFIG + FLEET ==================== -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="TARGET CONFIG" Style="{StaticResource Hdr}"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="host"     Grid.Row="0" Grid.Column="0" Style="{StaticResource Hdr}" VerticalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBox  x:Name="TgtHost" Grid.Row="0" Grid.Column="1" Style="{StaticResource Field}" Text="index.com" Margin="0,0,0,4"/>
                                    <TextBlock Text="port"     Grid.Row="1" Grid.Column="0" Style="{StaticResource Hdr}" VerticalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBox  x:Name="TgtPort" Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}" Text="443" Margin="0,0,0,4"/>
                                    <TextBlock Text="duration" Grid.Row="2" Grid.Column="0" Style="{StaticResource Hdr}" VerticalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBox  x:Name="Dur"     Grid.Row="2" Grid.Column="1" Style="{StaticResource Field}" Text="00:30:00" Margin="0,0,0,4"/>
                                    <TextBlock Text="thr/node" Grid.Row="3" Grid.Column="0" Style="{StaticResource Hdr}" VerticalAlignment="Center"/>
                                    <TextBox  x:Name="ThrNode" Grid.Row="3" Grid.Column="1" Style="{StaticResource Field}" Text="20"/>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="FLEET" Style="{StaticResource Hdr}"/>
                                        <TextBlock x:Name="FleetCount" Text="1000 nodes" Style="{StaticResource Val}" Foreground="{StaticResource Green}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="GROUPS" Style="{StaticResource Hdr}"/>
                                        <TextBlock x:Name="GroupCount" Text="50 · 10/node" Style="{StaticResource Val}" Foreground="{StaticResource Cyan}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,0">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="FLEET MATRIX  ·  50 × 10" Style="{StaticResource Hdr}"/>
                                    <TextBlock Grid.Column="1" x:Name="AliveNodes" Text="0/1000" Style="{StaticResource Hdr}" Foreground="{StaticResource Green}"/>
                                </Grid>
                                <Border BorderBrush="{StaticResource Edge}" BorderThickness="1" Background="#070A0F" CornerRadius="2">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2">
                                        <UniformGrid x:Name="FleetGrid" Columns="5" Rows="10"/>
                                    </ScrollViewer>
                                </Border>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- ==================== CENTER : CONSOLE + TELEMETRY ==================== -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="196"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="0">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="10,8,10,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="LIVE DISPATCH CONSOLE" Style="{StaticResource Hdr}" Margin="0"/>
                                    <Border Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0"
                                            BorderBrush="#3A2A12" BorderThickness="1" CornerRadius="2" Padding="5,1" Background="#100C06">
                                        <TextBlock Text="SIMULATED FEED" Foreground="{StaticResource Amber}" FontSize="8.5" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" x:Name="PpsLabel" Text="0 pps" Style="{StaticResource Hdr}" Foreground="{StaticResource Cyan}" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="3" x:Name="GbpsLabel" Text="0.0 Gbps" Style="{StaticResource Hdr}" Foreground="{StaticResource Green}" Margin="0"/>
                                </Grid>
                                <Border BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Background="#070A0F" ClipToBounds="True">
                                    <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="8">
                                        <TextBlock x:Name="LogBlock" FontFamily="Consolas" FontSize="11.5" TextWrapping="NoWrap"
                                                   LineStackingStrategy="BlockLineHeight" LineHeight="16"/>
                                    </ScrollViewer>
                                </Border>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="EGRESS TELEMETRY  ·  Gbps over T" Style="{StaticResource Hdr}" Margin="0"/>
                                    <TextBlock Grid.Column="1" Text="cosmetic · generated" Foreground="#33404F" FontSize="8.5" Margin="0,0,0,3"/>
                                </Grid>
                                <Border BorderBrush="{StaticResource Edge}" BorderThickness="1" Background="#070A0F" CornerRadius="3">
                                    <Canvas x:Name="GraphHost" ClipToBounds="True">
                                        <Canvas.Background>
                                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                <GradientStop Color="#06140E" Offset="0"/>
                                                <GradientStop Color="#0A0F16" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Canvas.Background>
                                        <Polyline x:Name="GridLine1" Stroke="#13202C" StrokeThickness="1"/>
                                        <Polyline x:Name="GridLine2" Stroke="#13202C" StrokeThickness="1"/>
                                        <Polyline x:Name="GridLine3" Stroke="#13202C" StrokeThickness="1"/>
                                        <Polygon x:Name="TrafficFill" Stroke="#0F3A26" StrokeThickness="1">
                                            <Polygon.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#5522FF88" Offset="0"/>
                                                    <GradientStop Color="#00101A14" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Polygon.Fill>
                                        </Polygon>
                                        <Polyline x:Name="TrafficLine" Stroke="#22FF88" StrokeThickness="1.5"/>
                                        <TextBlock x:Name="PeakLabel" Canvas.Left="8" Canvas.Top="4" Foreground="{StaticResource Dim}" FontSize="9.5" Text="peak 0.0 Gbps"/>
                                    </Canvas>
                                </Border>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- ==================== RIGHT : PATTERN + STATS ==================== -->
                    <Grid Grid.Column="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="PATTERN MIX" Style="{StaticResource Hdr}"/>
                                <StackPanel Margin="0,4,0,0">
                                    <DockPanel Margin="0,0,0,3">
                                        <Border DockPanel.Dock="Left" Width="5" Background="{StaticResource Green}" Margin="0,0,8,0"/>
                                        <TextBlock Text="A · NTP MONLIST AMP" FontSize="10.5" Foreground="{StaticResource Green}" FontFamily="Consolas"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,3">
                                        <Border DockPanel.Dock="Left" Width="5" Background="{StaticResource Cyan}" Margin="0,0,8,0"/>
                                        <TextBlock Text="B · SYN+ACK REFLECT" FontSize="10.5" Foreground="{StaticResource Cyan}" FontFamily="Consolas"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,3">
                                        <Border DockPanel.Dock="Left" Width="5" Background="{StaticResource Amber}" Margin="0,0,8,0"/>
                                        <TextBlock Text="C · H2 SETTINGS FLOOD" FontSize="10.5" Foreground="{StaticResource Amber}" FontFamily="Consolas"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="5" Background="{StaticResource Purple}" Margin="0,0,8,0"/>
                                        <TextBlock Text="D · H2 PING+DATA(0)" FontSize="10.5" Foreground="{StaticResource Purple}" FontFamily="Consolas"/>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="RUNTIME STATS  ·  FAKE" Style="{StaticResource Hdr}"/>

                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="EGRESS" Style="{StaticResource Hdr}"/>
                                        <TextBlock x:Name="sEgress" Grid.Column="1" Text="0.0 Gbps" Style="{StaticResource Val}" Foreground="{StaticResource Green}"/>
                                    </Grid>
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="REFLECTED" Style="{StaticResource Hdr}"/>
                                        <TextBlock x:Name="sReflected" Grid.Column="1" Text="0.0 Gbps" Style="{StaticResource Val}" Foreground="{StaticResource Cyan}"/>
                                    </Grid>
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="PPS" Style="{StaticResource Hdr}"/>
                                        <TextBlock x:Name="sPps" Grid.Column="1" Text="0" Style="{StaticResource Val}" Foreground="{StaticResource Txt}"/>
                                    </Grid>
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="AMP FACTOR" Style="{StaticResource Hdr}"/>
                                        <TextBlock x:Name="sAmp" Grid.Column="1" Text="—" Style="{StaticResource Val}" Foreground="{StaticResource Amber}"/>
                                    </Grid>
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="FRAG EVASION" Style="{StaticResource Hdr}"/>
                                        <TextBlock x:Name="sFrag" Grid.Column="1" Text="off" Style="{StaticResource Val}" Foreground="{StaticResource Purple}"/>
                                    </Grid>
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="HOPS (TRACE)" Style="{StaticResource Hdr}"/>
                                        <TextBlock x:Name="sHops" Grid.Column="1" Text="--" Style="{StaticResource Val}" Foreground="{StaticResource Red}"/>
                                    </Grid>

                                    <Border BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Margin="0,9,0,7"/>
                                    <TextBlock Text="ROUTE (ANON CHAIN)" Style="{StaticResource Hdr}"/>
                                    <TextBlock x:Name="Route" Text="—" FontSize="10.5" Foreground="{StaticResource Dim}" FontFamily="Consolas" TextWrapping="Wrap"/>

                                    <Border BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Margin="0,9,0,7"/>
                                    <TextBlock Text="BINARY HASH" Style="{StaticResource Hdr}"/>
                                    <TextBlock x:Name="BinHash" Text="--" FontSize="10" Foreground="{StaticResource Cyan}" FontFamily="Consolas" TextWrapping="Wrap"/>

                                    <!-- ══ the honest part: static proof this build cannot send ══ -->
                                    <Border BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Margin="0,9,0,7"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="INTEGRITY AUDIT" Style="{StaticResource Hdr}" Margin="0"/>
                                        <Border Grid.Column="1" BorderBrush="#1E4F3A" BorderThickness="1" CornerRadius="2" Padding="4,0" Background="#08130D">
                                            <TextBlock x:Name="AuditVerdict" Text="PASS" Foreground="{StaticResource Green}" FontSize="8.5" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="net assemblies" Style="{StaticResource Hdr}"/>
                                        <TextBlock x:Name="AuditNetRefs" Grid.Column="1" Text="0" Style="{StaticResource Val}" FontSize="10.5" Foreground="{StaticResource Dim}"/>
                                    </Grid>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="System.Net types" Style="{StaticResource Hdr}"/>
                                        <TextBlock x:Name="AuditNetTypes" Grid.Column="1" Text="0" Style="{StaticResource Val}" FontSize="10.5" Foreground="{StaticResource Dim}"/>
                                    </Grid>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="packets · sockets · procs" Style="{StaticResource Hdr}"/>
                                        <TextBlock x:Name="AuditCounters" Grid.Column="1" Text="0 · 0 · 0" Style="{StaticResource Val}" FontSize="10.5" Foreground="{StaticResource Dim}"/>
                                    </Grid>
                                    <TextBlock x:Name="AuditNote" Text="static scan of this assembly · no send path exists"
                                               FontSize="8.5" Foreground="#33404F" TextWrapping="Wrap" Margin="0,4,0,0"/>

                                    <Border BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Margin="0,9,0,7"/>
                                    <TextBlock Text="PHASE TRACK" Style="{StaticResource Hdr}"/>
                                    <StackPanel x:Name="PhaseTrack" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===================== FOOTER : CONTROLS ===================== -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,0" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnInit"   Grid.Column="0" Style="{StaticResource Btn}" Content="INITIALIZE FLEET" Margin="0,0,8,0"/>
                        <Button x:Name="BtnEngage" Grid.Column="1" Style="{StaticResource Btn}" Content="ENGAGE ▸" Margin="0,0,8,0" BorderBrush="#1E4F3A" Foreground="{StaticResource Green}"/>
                        <Button x:Name="BtnAbort"  Grid.Column="2" Style="{StaticResource Btn}" Content="ABORT ◂" Margin="0,0,0,0" BorderBrush="#5A2A38" Foreground="{StaticResource Red}"/>

                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock x:Name="PhaseLabel" Text="STANDBY" Style="{StaticResource Hdr}" Margin="0,0,0,3"/>
                            <ProgressBar x:Name="Prog" Height="10" Minimum="0" Maximum="100" Value="0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="SIMULATION BUILD · NO TRAFFIC" Foreground="{StaticResource Amber}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right"/>
                            <TextBlock Text="0 packets · 0 sockets · no target contact" Foreground="{StaticResource Dim}" FontSize="8.5" HorizontalAlignment="Right"/>
                            <TextBlock Text="F5 init · F6 engage · F7 abort · F12 capture" Foreground="#33404F" FontSize="8.5" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══════════════════════ SPLASH / HONESTY CARD ═══════════════════════ -->
            <Border x:Name="SplashLayer" Background="#05070A" Margin="-10">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="■" Foreground="{StaticResource Red}" FontSize="30" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="NTPX//RUST" Foreground="{StaticResource Green}" FontSize="30" FontWeight="Black" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="DISTRIBUTED STRESS CONSOLE  ·  SIMULATION BUILD 4.0.0"
                                   Foreground="{StaticResource Dim}" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <Border Height="1" Background="#16202C" Margin="0,22,0,20"/>

                        <TextBlock Foreground="{StaticResource Txt}" FontSize="13" LineHeight="24" HorizontalAlignment="Center" TextAlignment="Center">
                            <Run Text="This console is a " /><Run Text="visual mock" Foreground="{StaticResource Amber}" FontWeight="Bold"/><Run Text=". It opens no sockets,"/>
                            <LineBreak/>
                            <Run Text="resolves no hostnames, sends no packets and spawns no processes."/>
                            <LineBreak/>
                            <Run Text="Every number, log line and curve is generated locally by " /><Run Text="System.Random" Foreground="{StaticResource Cyan}"/><Run Text="."/>
                        </TextBlock>

                        <Border Height="1" Background="#16202C" Margin="0,20,0,16"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,22">
                            <Border BorderBrush="#1E4F3A" BorderThickness="1" CornerRadius="3" Padding="10,5" Margin="0,0,8,0" Background="#08130D">
                                <TextBlock Text="NET REFS 0" Foreground="{StaticResource Green}" FontSize="10"/>
                            </Border>
                            <Border BorderBrush="#1E4F3A" BorderThickness="1" CornerRadius="3" Padding="10,5" Margin="0,0,8,0" Background="#08130D">
                                <TextBlock Text="SOCKETS 0" Foreground="{StaticResource Green}" FontSize="10"/>
                            </Border>
                            <Border BorderBrush="#1E4F3A" BorderThickness="1" CornerRadius="3" Padding="10,5" Background="#08130D">
                                <TextBlock Text="PACKETS 0" Foreground="{StaticResource Green}" FontSize="10"/>
                            </Border>
                        </StackPanel>

                        <Button x:Name="BtnEnter" Style="{StaticResource Btn}" Content="ENTER CONSOLE ▸"
                                HorizontalAlignment="Center" Padding="26,10" FontSize="13"
                                BorderBrush="#1E4F3A" Foreground="{StaticResource Green}"/>
                        <TextBlock x:Name="SplashCountdown" Text="auto-continue in 4s"
                                   Foreground="#33404F" FontSize="9" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
